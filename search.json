---
layout: null
---
[
{% for post in site.posts %}
  {
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | default: post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%d %b %Y" | jsonify }},
    "category": {{ post.category | default: post.categories.first | default: "Writeup" | jsonify }},
    "tags": {{ post.tags | join: " " | jsonify }},
    "readingTime": {{ post.reading_time | default: "10 min read" | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
